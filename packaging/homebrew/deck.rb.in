class Deck < Formula
  desc "Terminal multiplexer with first-class support for coding agents"
  homepage "https://github.com/marcosmoura/deck"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/marcosmoura/deck/releases/download/v@VERSION@/deck-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/marcosmoura/deck/releases/download/v@VERSION@/deck-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/marcosmoura/deck/releases/download/v@VERSION@/deck-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_AARCH64_UNKNOWN_LINUX_GNU@"
    end
    on_intel do
      url "https://github.com/marcosmoura/deck/releases/download/v@VERSION@/deck-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_X86_64_UNKNOWN_LINUX_GNU@"
    end
  end

  def install
    bin.install "deck"
  end

  def caveats
    <<~EOS
      To see what Claude Code, Codex and OpenCode are doing in the sidebar, run once:
        deck hooks install claude codex opencode
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/deck --version")
  end
end
